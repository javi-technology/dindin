rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Documento do usuário
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Carteiras do usuário
      match /wallets/{walletId} {
        allow read, write: if isOwner(userId);

        // Posições dentro de uma carteira
        match /positions/{positionId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Geladeiras do usuário
      match /fridges/{fridgeId} {
        allow read, write: if isOwner(userId);

        // Itens dentro de uma geladeira
        match /fridgeItems/{itemId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Proventos do usuário
      match /dividends/{dividendId} {
        allow read, write: if isOwner(userId);
      }

      // Snapshots patrimoniais gerados exclusivamente pelo backend
      match /patrimonySnapshots/{date} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

    }

    // Cotações — leitura pública (qualquer usuário autenticado),
    // escrita apenas via Cloud Function (admin SDK bypassa as regras).
    match /quotes/{ticker} {
      allow read: if request.auth != null;
      allow write: if false;

      match /history/{date} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Catálogo de ativos suportados — leitura pública (qualquer usuário
    // autenticado), usado para popular o seletor de tickers no cadastro
    // de posições/itens da geladeira. Escrita apenas via admin/seed
    // (admin SDK bypassa as regras).
    match /assets/{ticker} {
      allow read: if request.auth != null;
      allow write: if false;
    }

  }
}
