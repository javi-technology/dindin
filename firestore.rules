rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Documento do usuário
    //
    // Leitura pelo proprietário; escrita exclusiva do Admin SDK (issue #218).
    // Toda gravação nas coleções de domínio passa pela API, que valida moeda,
    // tipo de ativo, quantidade e preço antes de persistir. O frontend nunca
    // escreve direto no Firestore — consome a API via HttpClient. Liberar
    // escrita ao cliente abriria um caminho para contornar essa validação e
    // gravar, por exemplo, posição com quantidade negativa ou moeda inexistente.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;

      // Carteiras do usuário
      match /wallets/{walletId} {
        allow read: if isOwner(userId);
        allow write: if false;

        // Posições dentro de uma carteira
        match /positions/{positionId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      // Geladeiras do usuário
      match /fridges/{fridgeId} {
        allow read: if isOwner(userId);
        allow write: if false;

        // Itens dentro de uma geladeira
        match /fridgeItems/{itemId} {
          allow read: if isOwner(userId);
          allow write: if false;
        }
      }

      // Proventos do usuário
      match /dividends/{dividendId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Snapshots patrimoniais gerados exclusivamente pelo backend
      match /patrimonySnapshots/{date} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      // Sugestões geradas pela IA exclusivamente via Cloud Function
      match /aiSuggestions/{id} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /aiSuggestionUsage/{id} {
        allow read, write: if false;
      }

      // Assinatura do usuário — escrita exclusiva pelo Admin SDK
      match /billing/{doc} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

    }

    // Cotações — leitura pública (qualquer usuário autenticado),
    // escrita apenas via Cloud Function (admin SDK bypassa as regras).
    match /quotes/{ticker} {
      allow read: if request.auth != null;
      allow write: if false;

      match /history/{date} {
        allow read: if request.auth != null;
        allow write: if false;
      }
    }

    // Catálogo de ativos suportados — leitura pública (qualquer usuário
    // autenticado), usado para popular o seletor de tickers no cadastro
    // de posições/itens da geladeira. Escrita apenas via admin/seed
    // (admin SDK bypassa as regras).
    match /assets/{ticker} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Carteiras recomendadas — escrita exclusiva pelo Admin SDK.
    match /recommendedWallets/{walletId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Idempotência de webhooks de billing — acesso exclusivo pelo Admin SDK.
    match /billingEvents/{eventId} {
      allow read, write: if false;
    }

  }
}
