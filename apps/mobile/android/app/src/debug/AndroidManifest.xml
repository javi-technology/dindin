<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Os emuladores do Firebase (Auth, Hosting) só falam HTTP. Vale só no
         debug: o manifesto de main bloqueia HTTP sem TLS de forma explícita
         (até o Android 8.1 o padrão da plataforma é permitir), e aqui esse
         bloqueio é substituído.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
