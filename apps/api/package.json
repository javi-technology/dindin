{
  "name": "dindin-api",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "firebase emulators:exec --only firestore --project dindin-test 'jest'",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed:assets": "npm run build && node lib/scripts/seed-assets.js",
    "set:admin-claim": "npm run build && node lib/scripts/set-admin-claim.js"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.4.0",
    "firebase-functions": "^7.3.2",
    "pdf-parse": "^1.1.1",
    "stripe": "^22.6.1",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.6.0"
  }
}
