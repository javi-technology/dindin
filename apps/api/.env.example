# Brapi API key do plano gratuito — obter em https://brapi.dev
# A Brapi é a reserva de cotação (issue #598): só recebe os tickers que o
# Yahoo Finance não cobriu, um por chamada. Proventos vêm da B3 Listados e o
# fechamento oficial do COTAHIST da B3, sem chave.
# Para deploy, usar: firebase functions:secrets:set BRAPI_API_KEY
# A key é enviada via header Authorization: Bearer (não via query string)
BRAPI_API_KEY=your_key_here

# Cobrança (issue #594). O DinDin é ferramenta gratuita: ausente ou diferente
# de `true`, todo usuário recebe todos os recursos e nenhuma assinatura nova é
# aberta (checkout e compra in-app respondem 409 BILLING_DISABLED). O workflow
# de deploy não escreve esta variável, então produção fica com a cobrança
# desligada. Religar é deliberado: ver a seção "Cobrança desligada" do AGENTS.md.
# BILLING_ENABLED=true

# Stripe — ids dos Prices do produto "DinDin Básico" e URL base dos redirects.
# Secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET) via
# firebase functions:secrets:set. Em produção, os valores abaixo vêm das
# variáveis do GitHub Actions (vars) escritas pelo workflow no deploy.
STRIPE_PRICE_BASIC_MONTHLY=price_...
STRIPE_PRICE_BASIC_YEARLY=price_...
APP_BASE_URL=https://dindin-4e720.web.app

# Versão mínima do app aceita pela API (issue #500). Abaixo dela a API responde
# 426 `APP_UPDATE_REQUIRED` e o app mostra a tela de atualização obrigatória.
# Vazio ou ausente = 1.0.0 (todo app publicado). Em produção vem da variável
# do GitHub Actions APP_MIN_VERSION. Política em docs/compatibilidade-app-api.md.
APP_MIN_VERSION=1.0.0
