# Brapi API key — obter em https://brapi.dev
# Para deploy, usar: firebase functions:secrets:set BRAPI_API_KEY
# A key é enviada via header Authorization: Bearer (não via query string)
BRAPI_API_KEY=your_key_here

# Quantidade máxima de tickers por requisição à Brapi. O plano gratuito
# permite apenas 1; planos pagos (Startup: 10, Pro: 20) permitem mais.
# Ver https://brapi.dev/faq/quais-as-limitacoes
#
# Em produção (CI/CD), o valor vem da variável do GitHub Actions
# BRAPI_MAX_SYMBOLS_PER_REQUEST (Settings > Environments > production >
# Variables) e é escrito em apps/api/.env.dindin-4e720 pelo workflow
# antes do deploy — não é um secret, é configuração pública do plano.
BRAPI_MAX_SYMBOLS_PER_REQUEST=1
