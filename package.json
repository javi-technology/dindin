{
  "name": "dindin",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "web:build": "npm run build --workspace=apps/web",
    "web:serve": "npm run start --workspace=apps/web",
    "api:build": "npm run build --workspace=apps/api",
    "api:serve": "npm run serve --workspace=apps/api",
    "emulators": "npm run api:build && npm run build --workspace=apps/web -- --configuration development && firebase emulators:start",
    "deploy": "firebase deploy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,html,css,scss,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "firebase-tools": "^15.30.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "gaxios@6": {
      "uuid": "^11.1.1"
    },
    "postcss@<8.5.23": "^8.5.28",
    "vite@6": "^6.4.3",
    "esbuild@0.28": "^0.28.2",
    "@babel/core@<7.29.6": "^7.29.7",
    "@angular/fire": {
      "firebase-tools": "$firebase-tools"
    }
  }
}
