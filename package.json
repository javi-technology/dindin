{
  "name": "dindin",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "docs:rules": "node scripts/sync-rules.mjs",
    "docs:rules:check": "node scripts/sync-rules.mjs --check",
    "web:build": "npm run build --workspace=apps/web",
    "web:serve": "npm run start --workspace=apps/web",
    "api:build": "npm run build --workspace=apps/api",
    "api:serve": "npm run serve --workspace=apps/api",
    "emulators": "npm run api:build && npm run build --workspace=apps/web -- --configuration development && firebase emulators:start",
    "deploy": "firebase deploy",
    "lint": "npm run lint --workspaces --if-present && eslint packages",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "firebase-tools": "^15.30.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "gaxios@6": {
      "uuid": "^11.1.1"
    },
    "postcss@<8.5.23": "^8.5.28",
    "vite@6": "^6.4.3",
    "esbuild@0.28": "^0.28.2",
    "@babel/core@<7.29.6": "^7.29.7",
    "@angular/fire": {
      "firebase-tools": "$firebase-tools"
    }
  }
}
