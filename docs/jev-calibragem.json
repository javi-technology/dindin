    "priority": {
      "type": "choice",
      "instructions": "Qual a prioridade desta issue de um app financeiro pessoal? Use o risco ao usuário e aos dados, não o tamanho do trabalho.",
      "criteria": {
        "P0": "Incidente em produção ou bloqueante: o app ou o deploy está quebrado agora",
        "P1": "Risco financeiro ou de dados: pode mostrar valor errado, duplicar registro, vazar dado, conceder ou negar acesso pago indevidamente, ou afeta segurança",
        "P2": "Melhoria relevante de produto, confiabilidade ou qualidade, sem risco imediato a dinheiro ou dados",
        "P3": "Desejável: polimento, refactor, documentação ou ajuste de conveniência que pode esperar"
      }
    },
    "size": {
      "type": "choice",
      "instructions": "Qual o tamanho da mudança, medido por quantidade de arquivos e camadas afetadas (API, web, mobile, regras, CI, docs)?",
      "criteria": {
        "XS": "Um ou dois arquivos, numa só camada, mudança mínima",
        "S": "Poucos arquivos numa só camada",
        "M": "Várias partes de uma camada, ou uma mudança simples em duas camadas",
        "L": "Várias camadas, ou módulo novo com testes",
        "XL": "Mudança ampla e transversal, em várias camadas e com migração ou infraestrutura"
      }
    },
    "estimate": {
      "type": "choice",
      "instructions": "Quantos story points de esforço relativo? Ajuste pontual = 1 a 2; feature ponta a ponta = 5.",
      "criteria": {
        "1": "Trivial, poucos minutos de trabalho",
        "2": "Ajuste pontual simples",
        "3": "Tarefa média, bem entendida",
        "5": "Feature ponta a ponta ou trabalho com várias partes",
        "8": "Grande e com incerteza, no limite de caber em uma issue"
      }
    }
  },
