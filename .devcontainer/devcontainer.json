// Ambiente isolado para os agentes de IA (issue #538). O guia está em
// docs/devcontainer.md, e a suíte da API (tests/devcontainer.spec.ts) reprova
// montagem da home do host e versão divergente do CI.
{
  "name": "DinDin",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "NODE_VERSION": "22",
      "FLUTTER_VERSION": "3.47.5",
      "RTK_VERSION": "0.50.0"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "jdkDistro": "tem"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "remoteUser": "node",
  // Alcança serviços do host, como o ai-memory. O Docker Desktop já resolve
  // o nome; a entrada vale para o Docker no Linux.
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "mounts": [
    // O ssh-agent do host assina o push sem que a chave entre no container.
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind",
    // Login do gh, que sobrevive ao rebuild.
    "source=dindin-gh-config,target=/home/node/.config/gh,type=volume",
    // Configuração global do git, com a identidade do autor.
    "source=dindin-git-config,target=/home/node/.config/git,type=volume",
    // Binários nativos do macOS não rodam no Linux, e o .dart_tool guarda
    // caminhos absolutos: cada lado tem a sua cópia.
    "source=dindin-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=dindin-api-node-modules,target=${containerWorkspaceFolder}/apps/api/node_modules,type=volume",
    "source=dindin-web-node-modules,target=${containerWorkspaceFolder}/apps/web/node_modules,type=volume",
    "source=dindin-mobile-dart-tool,target=${containerWorkspaceFolder}/apps/mobile/.dart_tool,type=volume"
  ],
  "containerEnv": {
    // Porta do túnel SSH do host até o ai-memory (docs/devcontainer.md).
    "AI_MEMORY_PORT": "${localEnv:AI_MEMORY_PORT:49374}",
    // O VS Code copia o ~/.gitconfig do host e registra um credential helper
    // que devolve as credenciais HTTPS do host. O global aponta para o volume,
    // então a cópia não é lida; e a configuração por variável vence todos os
    // arquivos, com o helper vazio zerando a lista. O push usa o ssh-agent.
    "GIT_CONFIG_GLOBAL": "/home/node/.config/git/config",
    "GIT_CONFIG_COUNT": "1",
    "GIT_CONFIG_KEY_0": "credential.helper",
    "GIT_CONFIG_VALUE_0": ""
  },
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock",
    // O token vem do ambiente do host. No remoteEnv ele chega só aos
    // processos da ferramenta; no containerEnv ficaria gravado na
    // configuração do container, visível num `docker inspect`.
    "AI_MEMORY_TOKEN": "${localEnv:AI_MEMORY_TOKEN}"
  },
  // Hosting, Functions, Firestore, Auth, interface dos emuladores e ng serve.
  "forwardPorts": [5002, 5001, 8080, 9099, 4000, 4200],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh",
  "customizations": {
    "vscode": {
      // O askpass do git do VS Code usaria a conta do GitHub logada no host.
      "settings": {
        "git.terminalAuthentication": false,
        "github.gitAuthentication": false
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "angular.ng-template",
        "dart-code.flutter"
      ]
    }
  }
}
